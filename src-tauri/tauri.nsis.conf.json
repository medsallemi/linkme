{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Linkme",
    "resources": {
      "../LICENSE": "licenses/Linkme-LICENSE.txt",
      "../src/assets/bootstrap-icons-LICENSE.txt": "licenses/bootstrap-icons-LICENSE.txt",
      "../THIRD_PARTY_NOTICES.txt": "licenses/THIRD_PARTY_NOTICES.txt"
    },
    "shortDescription": "A local link organizer for Windows",
    "useLocalToolsDir": true,
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "Linkme",
        "languages": ["English"],
        "installerHooks": "installer/policy.nsh",
        "template": "target/release/windows-setup-work/linkme-installer.nsi"
      }
    }
  }
}
